<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mayan_customer_statement_wizard_form" model="ir.ui.view">
        <field name="name">mayan.customer.statement.wizard.form</field>
        <field name="model">mayan.customer.statement.wizard</field>
        <field name="arch" type="xml">
            <form string="Estado de cuenta Mayan">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                    <group col="4">
                        <field name="year"/>
                        <field name="month"/>
                    </group>
                </group>
                <notebook>
                    <page string="Historial de correos">
                        <div class="text-muted mb-2">
                            El historial corresponde a los socios y al período seleccionados.
                        </div>
                        <group col="6">
                            <field name="email_sent_count" readonly="1"/>
                            <field name="email_queued_count" readonly="1"/>
                            <field name="email_failed_count" readonly="1"/>
                        </group>
                        <field name="email_log_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0"
                                  default_order="create_date desc, id desc">
                                <field name="create_date" string="Intento"/>
                                <field name="partner_id"/>
                                <field name="recipient"/>
                                <field name="subject" optional="hide"/>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'sent'"
                                       decoration-info="state == 'queued'"
                                       decoration-danger="state == 'failed'"/>
                                <field name="sent_at" optional="show"/>
                                <field name="user_id" optional="hide"/>
                                <field name="failure_reason" optional="show"/>
                                <field name="attachment_id" column_invisible="1"/>
                                <button name="action_download_attachment"
                                        type="object"
                                        string="PDF"
                                        icon="fa-download"
                                        invisible="not attachment_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_send_statements" type="object"
                            string="Enviar estado de cuenta"
                            class="btn-primary"
                            groups="account.group_account_invoice"
                            confirm="Se generará y enviará un PDF individual a cada socio seleccionado. ¿Desea continuar?"/>
                    <button name="action_print" type="object" string="Generar PDF"
                            class="btn-secondary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mayan_customer_statement_wizard" model="ir.actions.act_window">
        <field name="name">Estado de cuenta Mayan</field>
        <field name="res_model">mayan.customer.statement.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_mayan_customer_statement_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mayan_customer_statement"
              name="Estado de cuenta Mayan"
              parent="account.menu_finance_receivables"
              action="action_mayan_customer_statement_wizard"
              groups="account.group_account_readonly,account.group_account_invoice"
              sequence="90"/>
</odoo>
