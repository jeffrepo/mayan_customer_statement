<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_tree_mayan_customer_statement" model="ir.ui.view">
        <field name="name">account.journal.list.mayan.customer.statement</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="mayan_otros_cargos" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_form_mayan_customer_statement" model="ir.ui.view">
        <field name="name">account.journal.form.mayan.customer.statement</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="after">
                <field name="mayan_otros_cargos"/>
            </xpath>
        </field>
    </record>
</odoo>
